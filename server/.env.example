# AI Mystery Room Environment Configuration
PORT=5000
NODE_ENV=development

# Optional: MongoDB connection string (falls back to resilient in-memory storage if omitted or offline)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Optional: Google Gemini API Key (falls back to rich procedural mystery generator if omitted)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Allowed frontend origins (comma-separated or single)
CLIENT_ORIGIN=http://localhost:5173
